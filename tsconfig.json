{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "paths": { "@data": ["./ui-cheatsheet/src/data.json"] }
  },
  "include": [
    "src",
    "scripts",
    "vite.config.ts",
    "ui-arcade/vitest.config.ts",
    "ui-arcade/src",
    "ui-practice/src",
    "ui-cheatsheet/src"
  ]
}
