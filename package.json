{
  "name": "learn-vim",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "author": "Mátyás Budavári <budavariam@gmail.com> (https://budavariam.github.io/)",
  "homepage": "https://budavariam.github.io/learn-vim",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "generate-data": "node scripts/generateData.js",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "pnpm generate-data && tsc -b",
    "lint": "pnpm lint:eslint && pnpm lint:knip && pnpm lint:format",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:knip": "knip",
    "lint:format": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "validate": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "ui-arcade": "workspace:*",
    "ui-cheatsheet": "workspace:*",
    "ui-practice": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.4.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "knip": "^6.42.1",
    "prettier": "^3.9.10",
    "sass": "^1.106.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
